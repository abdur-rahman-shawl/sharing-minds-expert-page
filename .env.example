# Application
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APP_BASE_URL=http://localhost:3000
# Keep false until the rollout checks and cross-app integration are verified.
MENTOR_APPLICATIONS_ENABLED=false

# Account-backed expert registration v3
# Apply and verify documentation/migrations/006-live-expert-registration-v3.sql first.
EXPERT_REGISTRATION_V3_ENABLED=false
EXPERT_REGISTRATION_DRAFT_SECRET=replace-with-an-independent-random-secret-at-least-32-characters-long
# Optional override. The default is __Secure-prefixed in production and HTTP-safe in local dev.
# EXPERT_REGISTRATION_DRAFT_COOKIE_NAME=custom-expert-registration-draft
# At cutover: false prevents new OTP/application creation while true preserves existing access.
LEGACY_MENTOR_APPLICATION_INTAKE_ENABLED=true
LEGACY_MENTOR_APPLICATION_ACCESS_ENABLED=true
# Keep false during v3 so authentication never mutates historical application rows.
LEGACY_MENTOR_APPLICATION_AUTO_CLAIM_ENABLED=false

# Guest mentor application security
MENTOR_APPLICATION_OTP_SECRET=replace-with-an-independent-random-secret-at-least-32-characters-long
MENTOR_APPLICATION_OTP_KEY_ID=v1
MENTOR_APPLICATION_SESSION_SECRET=replace-with-another-independent-random-secret-at-least-32-characters-long
MENTOR_APPLICATION_INTERNAL_API_SECRET=replace-with-a-server-to-server-secret-at-least-32-characters-long
MENTOR_APPLICATION_ALLOWED_ORIGINS=http://localhost:3000
# Set only when a trusted proxy overwrites the header; never trust a browser-supplied value.
MENTOR_APPLICATION_TRUSTED_IP_HEADER=
MENTOR_APPLICATION_COOKIE_NAME=__Secure-sharingminds-mentor-application


# First-party campaign attribution
# Apply documentation/migrations/005-campaign-attribution.sql before enabling.
CAMPAIGN_ATTRIBUTION_ENABLED=false
CAMPAIGN_ATTRIBUTION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters-long
PUBLIC_CAMPAIGN_STATS_ENABLED=false

# Protected applicant-level Excel reports
EXPERT_REPORT_AUTH_EMAIL=
EXPERT_REPORT_AUTH_PASSWORD=

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/sharingminds
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_MENTOR_APPLICATIONS_BUCKET=mentor-applications

# Gmail SMTP
GMAIL_APP_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
